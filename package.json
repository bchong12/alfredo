{
  "name": "alfredo",
  "version": "0.1.13",
  "description": "Your company brain in a database you own: board, docs, canvas and meetings, with a local MCP server for any AI agent.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,server \"npm:dev:app\" \"npm:dev:server\"",
    "dev:app": "vite --port 5210",
    "dev:server": "CRM_PORT=29982 tsx watch --env-file=.env.local server/index.ts",
    "serve": "tsx --env-file=.env.local server/index.ts",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "build": "vite build",
    "devices": "tsx -e \"import('./server/audio.ts').then(async m=>console.log(await m.listDevices()))\"",
    "postinstall": "node scripts/fix-pty.mjs",
    "desktop": "electron .",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.mjs --external:node-pty --external:@electric-sql/pglite --external:@huggingface/transformers --external:@electric-sql/pglite-pgvector --external:onnxruntime-node --external:sharp --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "desktop:build": "npm run build:desktop-ui && npm run build:server && node scripts/helper.mjs && electron-builder --mac --dir",
    "desktop:install": "npm run desktop:build && node scripts/install-app.mjs",
    "build:desktop-ui": "vite build --mode desktop",
    "desktop:build:mac": "npm run build:desktop-ui && npm run build:server && node scripts/helper.mjs && electron-builder --mac --dir",
    "release:mac": "npm run build:desktop-ui && npm run build:server && node scripts/helper.mjs && node scripts/release-mac.mjs",
    "ship": "node scripts/ship.mjs",
    "desktop:build:win": "npm run build:desktop-ui && npm run build:server && electron-builder --win --dir",
    "desktop:build:linux": "npm run build:desktop-ui && npm run build:server && electron-builder --linux --dir"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@huggingface/transformers": "^4.3.0",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/mcp": "^0.2.3",
    "@hono/node-server": "^1.19.9",
    "@lucide/svelte": "^1.37.0",
    "@milkdown/crepe": "^7.22.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.6",
    "concurrently": "^9.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hono": "^4.7.10",
    "jsonrepair": "^3.15.0",
    "marked": "^18.0.11",
    "pg": "^8.23.0",
    "svelte": "^5.20.0",
    "svelte-dnd-action": "^0.9.79",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "design.purist.alfredo",
    "productName": "Alfredo",
    "publish": [
      {
        "provider": "github",
        "owner": "bchong12",
        "repo": "alfredo"
      }
    ],
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "db/**/*",
      "cloudflare/**/*",
      "scripts/build-parakeet.sh",
      "package.json",
      "!desktop/icon/alfredo.iconset",
      "!desktop/icon/icon.png",
      "!node_modules/onnxruntime-web",
      "!node_modules/@img/sharp-libvips*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/icon/alfredo.icns",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "dist-helper/alfredo-audio",
          "to": "bin/alfredo-audio"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Alfredo records meetings and dictation on this Mac."
      },
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux",
        "!node_modules/@img/sharp-win32*",
        "!node_modules/@img/sharp-linux*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64"
      ]
    },
    "win": {
      "icon": "desktop/icon/icon.png",
      "target": [
        "dir"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux",
        "!node_modules/@img/sharp-darwin*",
        "!node_modules/@img/sharp-linux*"
      ]
    },
    "linux": {
      "icon": "desktop/icon/icon.png",
      "category": "Office",
      "target": [
        "dir"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32",
        "!node_modules/@img/sharp-darwin*",
        "!node_modules/@img/sharp-win32*"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
