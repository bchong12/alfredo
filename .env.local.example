# Everything here is optional. Alfredo runs with nothing set: you add
# workspaces (a folder on this Mac, Supabase or Cloudflare) from the app.

# Meeting write-ups use Claude Code on this Mac when `claude` is installed.
# Without it they go through OpenRouter with this key.
OPENROUTER_API_KEY=

# Lets Claude connect Supabase projects through the MCP without asking you
# for a token each time (supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=

# A shared workspace from the environment instead of the app: set all three
# and it appears as "Shared". `npm run db:push` applies db/schema.sql to it
# (needs SUPABASE_DB_URL, the Postgres connection string).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
# ALFRED_REMOTE_NAME=Shared

# Terms your meetings use, so the hosted transcriber spells them right.
# CRM_VOCABULARY=Acme, Kubernetes, Figma

CRM_PORT=29981
